---
import Logo from "./Logo.astro";
import { site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="bg-forest-900 text-white/75">
  <div class="container grid gap-10 pt-16 pb-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-block">
        <span class="sr-only">{site.name}</span>
        <Logo inverted />
      </a>
      <p class="mt-4 max-w-[280px] text-sm leading-relaxed">
        Your partner for precision agriculture technology in Nebraska. Smarter tech. Stronger farms.
      </p>
    </div>

    <div>
      <h4 class="mb-4 text-[0.9rem] font-bold tracking-wide text-white">Quick Links</h4>
      <ul class="flex flex-col gap-2.5 text-sm">
        {
          site.nav.slice(0, 5).map((item) => (
            <li>
              <a href={item.href} class="hover:text-gold-400">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="mb-4 text-[0.9rem] font-bold tracking-wide text-white">Customer Service</h4>
      <ul class="flex flex-col gap-2.5 text-sm">
        <li><a href="/support" class="hover:text-gold-400">Contact Us</a></li>
        <li><a href="/support" class="hover:text-gold-400">Shipping & Delivery</a></li>
        <li><a href="/support" class="hover:text-gold-400">Returns & Warranty</a></li>
        <li><a href="/support" class="hover:text-gold-400">Financing Options</a></li>
        <li><a href="/support#demo" class="hover:text-gold-400">Request Demo</a></li>
      </ul>
    </div>

    <div>
      <h4 class="mb-4 text-[0.9rem] font-bold tracking-wide text-white">Contact Us</h4>
      <div class="space-y-2 text-sm">
        {site.phone && <p>{site.phone}</p>}
        {site.email && <p>{site.email}</p>}
        {site.address && <p>{site.address}</p>}
        <p>{site.location}</p>
        {
          !site.phone && !site.email && (
            <p class="text-white/55">Phone and email coming soon.</p>
          )
        }
        <p class="pt-2">
          <a href="/locations" class="font-semibold text-gold-400 hover:text-gold-300">
            Visit our Lincoln store →
          </a>
        </p>
      </div>
    </div>
  </div>

  <div
    class="container flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-6 text-xs"
  >
    <span>© {year} {site.name}. All rights reserved.</span>
    <div class="flex gap-6">
      <a href="/support" class="hover:text-white">Privacy</a>
      <a href="/support" class="hover:text-white">Terms of Service</a>
    </div>
  </div>
</footer>
