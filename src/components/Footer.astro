---
import Logo from "./Logo.astro";
import { site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="bg-forest-900 text-white/75">
  <div class="container grid gap-10 pt-16 pb-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-block">
        <span class="sr-only">{site.name}</span>
        <Logo inverted />
      </a>
      <p class="mt-4 max-w-[280px] text-sm leading-relaxed">{site.tagline}</p>
    </div>

    <div>
      <h4 class="mb-4 text-[0.9rem] font-bold tracking-wide text-white">Quick Links</h4>
      <ul class="flex flex-col gap-2.5 text-sm">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-gold-400">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="mb-4 text-[0.9rem] font-bold tracking-wide text-white">What we do</h4>
      <ul class="flex flex-col gap-2.5 text-sm">
        {
          site.services.map((service) => (
            <li>{service}</li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4 class="mb-4 text-[0.9rem] font-bold tracking-wide text-white">Let's Talk Ag Tech</h4>
      <div class="space-y-3 text-sm">
        {
          site.people.map((person) => (
            <p>
              <span class="block font-semibold text-white">{person.name}</span>
              <a href={person.tel} class="hover:text-gold-400">
                {person.phone}
              </a>
            </p>
          ))
        }
        <p class="pt-1">{site.location}</p>
        <p>
          <a href="/service-area" class="hover:text-gold-400">
            Service area
          </a>
        </p>
      </div>
    </div>
  </div>

  <div
    class="container flex flex-wrap items-center justify-between gap-4 border-t border-white/10 py-6 text-xs"
  >
    <span>© {year} {site.legalName}. All rights reserved.</span>
    <div class="flex gap-6">
      <a href="/support" class="hover:text-white">Privacy</a>
      <a href="/support" class="hover:text-white">Terms of Service</a>
    </div>
  </div>
</footer>
