---
import { site } from "../config/site";
import type { z } from "zod";
import type { ProductResult } from "../utils/schemas";

interface Props {
  origin: string;
  product: NonNullable<z.infer<typeof ProductResult>>;
}

const { origin, product } = Astro.props;
const pageUrl = origin.replace(/\/$/, "");
const variant = product.variants.nodes[0];
const image = product.featuredImage?.url || product.images.nodes.find(Boolean)?.url;
const productUrl = `${pageUrl}/products/${product.handle}`;

const data = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: product.description || product.title,
  image: image || undefined,
  brand: product.vendor ? { "@type": "Brand", name: product.vendor } : undefined,
  sku: product.handle,
  offers: variant
    ? {
        "@type": "Offer",
        url: productUrl,
        priceCurrency: variant.price.currencyCode,
        price: variant.price.amount,
        availability: variant.availableForSale
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock",
        seller: {
          "@type": "LocalBusiness",
          "@id": `${pageUrl}/#business`,
          name: site.name,
        },
        areaServed: [...site.servedStates],
      }
    : undefined,
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
