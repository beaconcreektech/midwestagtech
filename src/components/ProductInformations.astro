---
import type { z } from "zod";
import type { MoneyV2Result } from "../utils/schemas";
import Money from "./Money.svelte";

export interface Props {
  price?: z.infer<typeof MoneyV2Result>;
  title: string;
  vendor?: string;
  description?: string | null;
}
const { price, title, vendor, description } = Astro.props as Props;
---

{
  vendor && (
    <p class="mb-2 text-xs font-bold tracking-wide text-forest-700 uppercase">{vendor}</p>
  )
}
<h1 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
  {title}
</h1>
{
  price && (
    <p class="mt-4 text-3xl font-extrabold text-forest-800">
      <Money price={price} />
    </p>
  )
}
{
  description && (
    <p class="mt-6 text-base leading-relaxed text-gray-600">{description}</p>
  )
}
