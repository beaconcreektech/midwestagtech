---
import { catalogCategories } from "../config/catalog";

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<nav class="flex flex-wrap gap-2" aria-label="Product categories">
  <a
    href="/products"
    class:list={[
      "rounded-full px-4 py-2 text-sm font-semibold",
      !current ? "bg-forest-800 text-white" : "bg-gray-100 text-gray-700 hover:bg-forest-100",
    ]}
  >
    All
  </a>
  {
    catalogCategories.map((category) => (
      <a
        href={`/products/${category.slug}`}
        class:list={[
          "rounded-full px-4 py-2 text-sm font-semibold",
          current === category.slug
            ? "bg-forest-800 text-white"
            : "bg-gray-100 text-gray-700 hover:bg-forest-100",
        ]}
      >
        {category.navLabel}
      </a>
    ))
  }
</nav>
