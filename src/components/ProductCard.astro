---
import type { z } from "zod";
import type { ProductResult } from "../utils/schemas";

import ShopifyImage from "./ShopifyImage.svelte";
import Money from "./Money.svelte";
import AddToCartForm from "./AddToCartForm.svelte";

export interface Props {
  product: z.infer<typeof ProductResult>;
}
const { product } = Astro.props as Props;
const firstVariant = product?.variants.nodes[0];
const blurb =
  product?.description?.trim().replace(/\s+/g, " ").slice(0, 110) ||
  "Precision ag equipment with local Midwest support.";
---

{
  product && (
    <article class="group flex flex-col overflow-hidden rounded-[20px] border border-gray-200 bg-white transition hover:-translate-y-1.5 hover:border-forest-500 hover:shadow-lg">
      <a href={`/products/${product.handle}`} class="relative block">
        <div class="relative grid h-[180px] place-items-center overflow-hidden bg-linear-to-br from-[#f0f4f2] to-[#e4ebe7]">
          {product.vendor && (
            <span class="absolute top-3 left-3 rounded-md bg-white px-2 py-1 text-[0.65rem] font-bold tracking-wide text-gray-700 shadow-sm">
              {product.vendor}
            </span>
          )}
          <ShopifyImage
            classList="h-full w-full object-contain p-4"
            loading="lazy"
            image={product.featuredImage}
            sizes="
              (min-width: 1280px) 280px,
              (min-width: 768px) 45vw,
              100vw
            "
          />
        </div>
      </a>
      <div class="flex flex-1 flex-col p-5">
        <h3 class="text-[1.05rem] font-bold tracking-tight">
          <a href={`/products/${product.handle}`} class="hover:text-forest-700">
            {product.title}
          </a>
        </h3>
        <p class="mt-1 mb-4 flex-1 text-sm text-gray-500">{blurb}</p>
        <div class="mb-4 flex items-center justify-between">
          <span class="text-lg font-extrabold text-gray-900">
            {firstVariant?.price && <Money price={firstVariant.price} />}
          </span>
        </div>
        {firstVariant ? (
          <AddToCartForm
            client:visible
            appearance="card"
            variantId={firstVariant.id}
            variantQuantityAvailable={firstVariant.quantityAvailable}
            variantAvailableForSale={firstVariant.availableForSale}
          />
        ) : (
          <a href={`/products/${product.handle}`} class="button w-full py-3 text-sm">
            View product
          </a>
        )}
      </div>
    </article>
  )
}
