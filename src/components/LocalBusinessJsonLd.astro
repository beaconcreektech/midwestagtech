---
import { site } from "../config/site";

interface Props {
  origin: string;
}

const { origin } = Astro.props;
const primary = site.people[0];
const pageUrl = origin.endsWith("/") ? origin.slice(0, -1) : origin;

const areaServed = [
  ...site.servedStates.map((name) => ({
    "@type": "AdministrativeArea",
    name,
  })),
  {
    "@type": "City",
    name: site.hometown,
    containedInPlace: { "@type": "State", name: site.regionName },
  },
  ...site.nearbyTowns.map((name) => ({
    "@type": "City",
    name,
    containedInPlace: { "@type": "State", name: site.regionName },
  })),
];

const data = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${pageUrl}/#website`,
      url: pageUrl,
      name: site.name,
      description: site.defaultDescription,
      publisher: { "@id": `${pageUrl}/#business` },
      inLanguage: "en-US",
    },
    {
      "@type": "LocalBusiness",
      "@id": `${pageUrl}/#business`,
      name: site.name,
      legalName: site.legalName,
      description: site.defaultDescription,
      url: pageUrl,
      image: `${pageUrl}${site.logo}`,
      logo: `${pageUrl}${site.logo}`,
      telephone: primary?.phone,
      address: {
        "@type": "PostalAddress",
        addressLocality: site.hometown,
        addressRegion: site.region,
        addressCountry: site.country,
      },
      areaServed,
      knowsAbout: [
        "Agricultural drones",
        "Spray drones",
        "Agricultural robotics",
        "Ag bots",
        "Precision agriculture",
        "Drone parts and service",
        "Equipment training",
      ],
      makesOffer: site.services.map((name) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name,
          areaServed: [...site.servedStates],
        },
      })),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
