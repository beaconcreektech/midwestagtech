---
import { z } from "zod";
import { ProductResult } from "../utils/schemas";
import ProductCard from "./ProductCard.astro";

const ProductsResult = z.array(ProductResult);
export interface Props {
  products: z.infer<typeof ProductsResult>;
  heading?: string;
  label?: string;
  intro?: string;
  emptyMessage?: string;
  compact?: boolean;
  hideHeader?: boolean;
  id?: string;
}
const {
  products,
  heading = "Technology That Drives Results",
  label = "Featured Products",
  intro = "High-performance ag tech designed for Midwest fields and farm operations.",
  emptyMessage = "Catalog is connecting — products will show here once they are published in Shopify.",
  compact = false,
  hideHeader = false,
  id = "products",
} = Astro.props as Props;

const items = products.filter(Boolean);
---

<section class:list={[compact ? "py-8" : "py-20", "container"]} id={id}>
  {
    !hideHeader && (
      <div class:list={[compact ? "mb-8 text-left" : "mb-12 text-center"]}>
        <p class="mb-2 text-sm font-bold tracking-[0.08em] text-forest-600 uppercase">{label}</p>
        <h2 class="mb-3 text-3xl font-extrabold tracking-tight text-gray-900">{heading}</h2>
        {intro && (
          <p class:list={[compact ? "max-w-2xl text-gray-500" : "mx-auto max-w-xl text-gray-500"]}>
            {intro}
          </p>
        )}
      </div>
    )
  }

  {
    items.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-6 py-16 text-center text-gray-500">
        {emptyMessage}
      </p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {items.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    )
  }
</section>
