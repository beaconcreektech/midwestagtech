---
import { site } from "../config/site";

interface Props {
  inverted?: boolean;
}

const { inverted = false } = Astro.props;
---

<span class:list={["inline-flex items-center", inverted ? "rounded-lg bg-white px-2 py-1.5" : ""]}>
  <img
    src={site.logo}
    alt={site.name}
    class="h-11 w-auto max-w-[220px] object-contain object-left sm:h-12 sm:max-w-[260px]"
    width="1205"
    height="416"
  />
</span>
