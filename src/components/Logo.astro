---
import { site } from "../config/site";

interface Props {
  inverted?: boolean;
}

const { inverted = false } = Astro.props;
---

<span class:list={["flex items-center gap-2.5", inverted ? "text-white" : "text-forest-800"]}>
  <span
    class="grid h-9 w-9 place-items-center rounded-[10px] bg-linear-to-br from-forest-600 to-forest-800 text-white"
    aria-hidden="true"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M12 2C8 6 4 10 4 14a8 8 0 0016 0c0-4-4-8-8-12z"></path>
      <path d="M12 22v-6"></path>
    </svg>
  </span>
  <span class="leading-tight">
    <span class="block text-[1.05rem] font-extrabold tracking-tight">{site.shortName}</span>
    <span
      class:list={[
        "block text-[0.7rem] font-semibold tracking-wide",
        inverted ? "text-white/50" : "text-forest-600",
      ]}
    >
      {site.tagline}
    </span>
  </span>
</span>
