---
import Logo from "./Logo.astro";
import CartIcon from "./CartIcon.svelte";
import { site } from "../config/site";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-white/92 backdrop-blur-md">
  <nav class="container flex h-20 items-center justify-between gap-6">
    <a href="/" class="shrink-0">
      <span class="sr-only">{site.name}</span>
      <Logo />
    </a>

    <ul class="hidden items-center gap-7 text-[0.925rem] font-medium text-gray-700 lg:flex">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "hover:text-forest-700",
                currentPath === item.href || currentPath.startsWith(`${item.href}/`)
                  ? "text-forest-700"
                  : "",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4">
      <div class="hidden items-center gap-1.5 text-sm font-medium text-gray-500 sm:flex">
        <svg
          class="h-3.5 w-3.5 text-forest-600"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {site.location}
      </div>
      <CartIcon client:load />

      <details class="relative lg:hidden">
        <summary
          class="grid h-10 w-10 cursor-pointer place-items-center rounded-[10px] bg-gray-100 text-gray-800"
        >
          <span class="sr-only">Menu</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 mt-2 w-48 rounded-xl border bg-white py-2 shadow-lg">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="block px-4 py-2 text-sm font-medium text-gray-700 hover:bg-forest-100">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
