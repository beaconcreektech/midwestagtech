---
import { getProducts } from "./../utils/shopify";
import BaseLayout from "../layouts/BaseLayout.astro";
import Products from "../components/Products.astro";
import { setCache } from "../utils/cache";
import { site } from "../config/site";

const headers = Astro.request.headers;
const ip = headers.get("x-vercel-forwarded-for") || Astro.clientAddress;
const products = await getProducts({ buyerIP: ip, limit: 8 });
const featured = products.filter(Boolean).slice(0, 4);

setCache.short(Astro);

const pillars = [
  {
    title: "New technology",
    body: "Agricultural drones, robotics, and emerging tools that fit how Midwest operations actually run.",
  },
  {
    title: "Practical solutions",
    body: "We focus on technology that works in the field — not gadgets that look good on paper.",
  },
  {
    title: "Local support",
    body: "Sales, parts, service, and training from people you can call. When you need help, you talk to us.",
  },
];
---

<BaseLayout title={site.name} description={site.description}>
  <header class="relative overflow-hidden bg-forest-900">
    <div class="relative z-10 container grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-20">
      <div>
        <p class="mb-4 text-sm font-bold tracking-[0.12em] text-gold-400 uppercase">
          {site.tagline}
        </p>
        <h1 class="mb-5 text-4xl leading-[1.12] font-extrabold tracking-tight text-white md:text-5xl">
          {site.headline}
        </h1>
        <p class="mb-4 max-w-xl text-lg leading-relaxed text-white/85">
          At Midwest Ag Technologies, we help farmers and ag businesses adopt new technology with confidence.
        </p>
        <p class="mb-8 max-w-xl leading-relaxed text-white/75">
          From agricultural drones and robotics to service, parts, and training, we provide practical solutions built
          for real-world operations.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/support#talk" class="btn btn-primary">Let's Talk Ag Tech</a>
          <a href="/products" class="btn btn-secondary">Shop equipment</a>
        </div>
      </div>

      <div class="relative">
        <img
          src="/hero-drone.jpg"
          alt="Agricultural spray drone on a trailer overlooking Midwest fields"
          class="aspect-4/3 w-full rounded-[20px] object-cover shadow-xl"
          width="360"
          height="365"
        />
        <img
          src="/hero-flight.jpg"
          alt="Agricultural spray drone in flight"
          class="absolute -bottom-6 -left-4 hidden w-36 rounded-2xl border-4 border-forest-900 object-cover shadow-lg sm:block md:w-44"
          width="175"
          height="190"
        />
      </div>
    </div>
  </header>

  <div class="bg-forest-800 text-white/90">
    <div class="container py-5">
      <p class="mb-4 text-center text-xs font-bold tracking-[0.14em] text-gold-400 uppercase">
        Ag technology + support
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-medium">
        {
          site.services.map((service) => (
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0 text-gold-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
              {service}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Products
    products={featured}
    label="Catalog"
    heading="Equipment, parts, and accessories"
    intro="Live inventory from the shop. Browse drones, trailers, accessories, and service parts."
  />

  <section class="bg-forest-100">
    <div class="container py-20">
      <div class="mb-12 text-center">
        <p class="mb-2 text-sm font-bold tracking-[0.08em] text-forest-600 uppercase">Why Midwest Ag Technologies</p>
        <h2 class="mb-3 text-3xl font-extrabold tracking-tight">{site.tagline}</h2>
        <p class="mx-auto max-w-2xl text-gray-600">
          Agriculture is evolving — and so is the technology behind it. We help you keep up without the guesswork.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {
          pillars.map((pillar) => (
            <div class="rounded-[20px] border border-gray-200 bg-white p-8">
              <h3 class="mb-2 text-lg font-bold text-forest-800">{pillar.title}</h3>
              <p class="text-[0.925rem] leading-relaxed text-gray-600">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="talk" class="relative overflow-hidden bg-forest-900 px-8 py-16 text-center text-white">
    <div class="relative mx-auto max-w-2xl">
      <h2 class="mb-3 text-3xl font-extrabold tracking-tight">Let's Talk Ag Tech</h2>
      <p class="mb-8 text-lg text-white/80">
        Whether you're exploring drones, robotics, or simply looking for better support, we're here to help.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {
          site.people.map((person) => (
            <a href={person.tel} class="btn btn-primary min-w-[220px] flex-col !gap-0 py-4">
              <span>{person.name}</span>
              <span class="text-sm font-medium opacity-90">{person.phone}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
