---
import InnerLayout from "../layouts/InnerLayout.astro";
---

<InnerLayout
  title="Support"
  intro="Training, parts, and service for the equipment we sell."
>
  <div id="demo" class="scroll-mt-24 max-w-xl rounded-2xl border bg-gray-50 p-8">
    <h2 class="mb-2 text-xl font-bold">Request a demo</h2>
    <p class="text-gray-600">
      Tell us what you’re running and we’ll schedule a walkthrough. A contact form lands here next — until then, use this page as the demo / specialist destination.
    </p>
  </div>
</InnerLayout>
