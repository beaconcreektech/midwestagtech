---
import InnerLayout from "../layouts/InnerLayout.astro";
import { site } from "../config/site";
---

<InnerLayout
  title={`About ${site.name}`}
  intro={`${site.headline} Based in ${site.location}. Agricultural drones, robotics, parts, and training.`}
>
  <div class="max-w-2xl space-y-5 text-gray-600">
    <p>
      At Midwest Ag Technologies, we help farmers and ag businesses adopt new technology with confidence. From
      agricultural drones and robotics to service, parts, and training, we provide practical solutions built for
      real-world operations.
    </p>
    <p>
      Agriculture is evolving — and so is the technology behind it. Our goal is simple: help you stay ahead with
      equipment, support, and expertise you can trust.
    </p>
    <p>
      We are based in {site.location} and work with growers in {site.serviceRegion}. {site.serviceAreaNote}
    </p>
    <p class="font-semibold text-forest-800">{site.tagline}</p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2">
    {
      site.people.map((person) => (
        <div class="rounded-2xl border bg-forest-100 p-6">
          <p class="text-lg font-bold text-forest-800">{person.name}</p>
          <a href={person.tel} class="mt-1 inline-block font-semibold text-gold-500 hover:text-gold-400">
            {person.phone}
          </a>
        </div>
      ))
    }
  </div>
</InnerLayout>
