---
import InnerLayout from "../layouts/InnerLayout.astro";
import { site } from "../config/site";
---

<InnerLayout
  title={`Ag Drones & Robotics in ${site.regionName}`}
  label="Service area"
  intro={`Based in ${site.location}. Agricultural drones, ag robots, parts, service, and training for farms across Nebraska.`}
>
  <div class="max-w-2xl space-y-5 text-gray-600">
    <p>
      Midwest Ag Technologies is based in {site.hometown}, {site.regionName}. We sell and support agricultural drones,
      robotics, parts, and training — practical gear for real operations, not a call center three states away.
    </p>
    <p>
      We work with growers throughout {site.regionName} and the Midwest. {site.serviceAreaNote}
    </p>
  </div>

  <h2 class="mt-12 mb-3 text-xl font-bold text-forest-800">Home base</h2>
  <p class="text-lg font-semibold text-forest-800">{site.location}</p>

  <h2 class="mt-10 mb-3 text-xl font-bold text-forest-800">Nearby towns</h2>
  <p class="mb-4 max-w-2xl text-sm text-gray-500">{site.serviceAreaNote}</p>
  <ul class="flex flex-wrap gap-2">
    {
      site.nearbyTowns.map((town) => (
        <li class="rounded-full bg-forest-100 px-3 py-1 text-sm font-medium text-forest-800">{town}</li>
      ))
    }
  </ul>

  <h2 class="mt-10 mb-3 text-xl font-bold text-forest-800">What people search for</h2>
  <ul class="max-w-xl list-disc space-y-2 pl-5 text-gray-600">
    <li>Ag drones and spray drones in Nebraska</li>
    <li>Agricultural robots / ag bots</li>
    <li>Drone parts, service, and equipment training</li>
  </ul>

  <p class="mt-10">
    <a href="/support#talk" class="font-semibold text-forest-700 underline">Call Brady or Tate</a>
    to see if we can get to your place.
  </p>
</InnerLayout>
