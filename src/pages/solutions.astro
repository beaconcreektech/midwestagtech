---
import InnerLayout from "../layouts/InnerLayout.astro";
import { site } from "../config/site";
---

<InnerLayout
  title={`Ag Drones, Robotics & Support in ${site.serviceRegion}`}
  label="Solutions"
  intro={`Agricultural drone sales, ag robots, parts, service, and training from ${site.name} in ${site.location}.`}
>
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      site.services.map((service) => (
        <li class="rounded-2xl border bg-white px-6 py-8">
          <p class="font-bold text-forest-800">{service}</p>
        </li>
      ))
    }
  </ul>
  <p class="mt-10 max-w-2xl text-gray-600">
    Browse live inventory in the <a href="/products" class="font-semibold text-forest-700 underline">product catalog</a>,
    or <a href="/support#talk" class="font-semibold text-forest-700 underline">call us</a> to talk through what fits
    your operation. {site.serviceAreaNote}
  </p>
</InnerLayout>
