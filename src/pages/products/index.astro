---
import { getProducts } from "../../utils/shopify";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Products from "../../components/Products.astro";
import { setCache } from "../../utils/cache";
import { site } from "../../config/site";

const headers = Astro.request.headers;
const ip = headers.get("x-vercel-forwarded-for") || Astro.clientAddress;
const products = await getProducts({ buyerIP: ip, limit: 24 });

setCache.short(Astro);
---

<BaseLayout title="Products" description={`Shop precision ag equipment from ${site.name}.`}>
  <Products
    products={products}
    label="Catalog"
    heading="Shop Equipment"
    intro="Live inventory from our Shopify catalog. Prices and availability come from the store."
  />
</BaseLayout>
